# ---------------------------------------------------------------------------
# Google AI Studio key. Covers BOTH embeddings and the tone/arbitration model.
# Get one free at: https://aistudio.google.com/apikey
# The app runs fine WITHOUT this - it serves the deterministic engine instead.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Which AI provider to use: "gemini" or "none"
AI_PROVIDER=gemini

# Secret used to salt rate-limit keys and sign admin sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SQLite file location (relative to project root).
DATABASE_URL=data/brics-faq.db

# Public base URL, used for canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# How many proxies sit in front of this process and append to x-forwarded-for.
#   0  exposed directly (local development)
#   1  behind our own Caddy
#   2  if the traffic police reverse proxy lands in front of Caddy
# This decides which end of the header is trusted, so it is deployment fact
# rather than a tuning knob. Too high reads an address that is not there; too
# low reads one the client supplied and can forge.
# ---------------------------------------------------------------------------
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# The three volume ceilings, per 15 minutes. Only the last one refuses service;
# the first two drop the visitor to the deterministic engine, which answers the
# same questions from the same approved text.
#
# Counters are in process memory and reset on restart, so raising one during the
# event is an edit here plus `systemctl restart brics-faq`.
# ---------------------------------------------------------------------------
# Per conversation. Catches one runaway client without touching anyone sharing
# its address.
SESSION_FLOOD_MAX=60
# Per address. Set above any plausible carrier-NAT crowd: Indian mobile traffic
# is behind CGNAT, so one address can be hundreds of genuine citizens.
ADDRESS_DEGRADE_MAX=2000
# Per address, the only volume path to a 429. ~6.7 req/s from a single address,
# which is above this whole deployment's expected sitewide peak.
ADDRESS_THROTTLE_MAX=6000

# Daily ceiling on Gemini calls, so one abuser cannot exhaust the free tier.
GEMINI_DAILY_QUOTA=1200

# Per-visitor AI budget before the bot degrades to the deterministic engine.
AI_BUDGET_PER_WINDOW=25
