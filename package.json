{
  "name": "brics-delhi-traffic-faq-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:embed": "tsx --conditions=react-server scripts/build-embeddings.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "lint:content": "tsx --conditions=react-server scripts/lint-content.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "db:init": "tsx --conditions=react-server scripts/db-init.ts",
    "seed:build": "tsx --conditions=react-server scripts/build-seed.ts",
    "seed:extract": "python3 scripts/extract-docx.py",
    "db:reset": "tsx --conditions=react-server scripts/db-reset.ts",
    "stress": "tsx --conditions=react-server scripts/stress.ts"
  },
  "dependencies": {
    "@indic-transliteration/sanscript": "^1.3.3",
    "@phosphor-icons/react": "^2.1.7",
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "talisman": "^1.1.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
